#include "dplasmajdf.h"
#include "parsec/data_dist/matrix/matrix.h"

%}

uplo      [type = "dplasma_enum_t"]
trans     [type = "dplasma_enum_t"]
alpha     [type = "dplasma_complex64_t"]
descA     [type = "const parsec_tiled_matrix_t*"]
beta      [type = "dplasma_complex64_t"]
descC     [type = "parsec_tiled_matrix_t*"]

/*******************************************************************
 *              zsyrk_pcctest                                      *
 *******************************************************************/
zsyrk_pcctest(n, k) [ flops = inline_c %{ return FLOPS_ZSYRK(CLEAN_NB(descC, n), CLEAN_NB(descA, k)); %} ]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descC(n,n)

  READ  A    <- A zsyrk_pcctest_in_data_A0(n, k)
  RW    C    <- ((0==k)) ? descC(n,n)
             <- ((k>=1)) ? C zsyrk_pcctest(n, k-1)
             -> ((descA->nt>=(2+k))) ? C zsyrk_pcctest(n, k+1)
             -> ((descA->nt==(k+1))) ? descC(n,n)

BODY
{
    int tempnn = (n==(descC->nt-1)) ? (descC->n-(n*descC->nb)) : descC->nb;
    int tempkn = (k==(descA->nt-1)) ? (descA->n-(k*descA->nb)) : descA->nb;
    int ldan = BLKLDD( descA, n );
    dplasma_complex64_t zbeta = (k==0) ? beta : ((dplasma_complex64_t)1.);
    int ldcn = BLKLDD( descC, n );

    printlog("CORE_zsyrk(%d, %d)\n"
             "\t(uplo, trans, tempnn=%d, tempkn=%d, alpha, A(%d,%d)[%p], ldan=%d, zbeta, C(%d,%d)[%p], ldcn=%d)\n",
             n, k, tempnn, tempkn, n, k, A, ldan, n, n, C, ldcn );
    CORE_zsyrk(uplo, trans, tempnn, tempkn,
               alpha, A /* descA(n,k) */, ldan,
               zbeta, C /* descC(n,n) */, ldcn );
    // printf("This is PCCTEST zsyrk zsyrk! (%d, %d, %d)\n", n, n, k);
    // ((dplasma_complex64_t *)C)[0] = 2.0; // signal of victory
}
END

/*******************************************************************
 *              PCC_load_A                                         *
 *******************************************************************/
// load in the matrix A, and add dependencies for the other tasks
PCC_load_A(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descA->mt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

RW A <- descA(n,k)
     -> A zsyrk_pcctest_in_data_A0(n,k)
     -> A zgemm_in_data_A0(n,k) // TODO: this appears to over-give the data
     -> B zgemm_in_data_A1(n,k)

// old dependencies from trying to get it to read a full line and sort out
// over here - for now we're going to just read in the correct file based
// on n and k
// CTL pass <- (n > 0) ? pass PCC_load_A(n-1)
         // -> (n < descC->nt-1) ? pass PCC_load_A(n+1)

BODY
{
    char fname[100];
    sprintf(fname, "split_sample_%d_%d.csv", n, k);
    
    int ldam = BLKLDD( descA, m );
    int tempnn = (n == descA->nt-1) ? descA->n - n*descA->nb : descA->nb;
    int tempkn = (k == descA->nt-1) ? descA->n - k*descA->nb : descA->nb;
    // printf("PCC load n=%d, k=%d, ldam=%d\n", n, k, ldam);
    // printf("do we have descA->mt & nt? %d %d\n", descA->mt, descA->nt);
    // printf("PCC load tempnn=%d, tempkn=%d\n", tempnn, tempkn);
    // printf("do we have descA->lm & ln? %d %d\n", descA->lm, descA->ln);
    FILE *f;
    f = fopen(fname, "r");
    int i, j;
    int fsfrv;
    for(i = 0; i < tempnn; i++)
    {
        for(j = 0; j < tempkn; j++)
        {
            fsfrv = fscanf(f, "%lf,", (&(((dplasma_complex64_t*)A)[i+ldam*j])));
        }
    }

    if (fsfrv == 0)
    {
        ; // keep compilers happy
    }
    fclose(f);
    // printf("Load A! This should load A(%d,%d)\n", n, k);
}
END

/*******************************************************************
 *              zsyrk_pcctest_in_data_A0                           *
 *******************************************************************/
zsyrk_pcctest_in_data_A0(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

  READ  A    <- A PCC_load_A(n,k)
             -> A zsyrk_pcctest(n, k)

BODY
{
    /* nothing */
}
END

/*******************************************************************
 *              zgemm                                              *
 *******************************************************************/
zgemm(n, m, k) [ flops = inline_c %{ return FLOPS_ZGEMM(CLEAN_NB(descC, n), CLEAN_MB(descC, m), CLEAN_NB(descA, k)); %} ]
  /* Execution Space */
  n = 0..(descC->mt-2)
  m = (n+1)..(descC->mt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descC(n,m)

  READ  A    <- A zgemm_in_data_A0(n, k)
  READ  B    <- B zgemm_in_data_A1(m, k)
  RW    C    <- ((0==k)) ? descC(n,m)
             <- ((k>=1)) ? C zgemm(n, m, k-1)
             -> ((descA->nt>=(k+2))) ? C zgemm(n, m, k+1)
             -> ((descA->nt==(k+1))) ? descC(n,m)

BODY
{
    int tempnn = (n==(descC->nt-1)) ? (descC->n-(n*descC->nb)) : descC->nb;
    int tempmm = ((m)==(descC->mt-1)) ? (descC->m-(m*descC->mb)) : descC->mb;
    int tempkn = (k==(descA->nt-1)) ? (descA->n-(k*descA->nb)) : descA->nb;
    int ldan = BLKLDD( descA, n );
    int ldam = BLKLDD( descA, m );
    dplasma_complex64_t zbeta = (k==0) ? beta : (dplasma_complex64_t)1.;
    int ldcn = BLKLDD( descC, n );

    // printf("This is PCCTEST zsyrk gemm! (%d, %d, %d)\n", n, m, k);
    printlog("CORE_zgemm(%d, %d, %d)\n"
             "\t(trans, dplasmaTrans, tempnn, tempmm, tempkn, zalpha, A(%d,%d)[%p], ldan, A(%d,%d)[%p], ldam, zbeta, C(%d,%d)[%p], ldcn)\n",
             n, m, k, n, k, A, m, k, B, n, m, C);
    CORE_zgemm(trans, dplasmaTrans, tempnn,
               tempmm, tempkn, alpha,
               A /* descA(n,k) */, ldan, B /* descA(m,k) */,
               ldam, zbeta, C /* descC(n,m) */,
               ldcn );
}
END

/*******************************************************************
 *              zgemm_in_data_A1                                   *
 *******************************************************************/
zgemm_in_data_A1(m, k) [profile = off]
  /* Execution Space */
  m = 1..(descC->mt-1) /* tight bound is (n+1)..(descC->mt-1) */
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(m,k)

  READ  B    <- A PCC_load_A(m,k)
             -> B zgemm(0..(descC->mt-2), m, k)

BODY
{
    /* nothing */
}
END

/*******************************************************************
 *              zgemm_in_data_A0                                   *
 *******************************************************************/
zgemm_in_data_A0(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->mt-2)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

  READ  A    <- A PCC_load_A(n,k)
             -> A zgemm(n, (n+1)..(descC->mt-1), k)

BODY
{
    /* nothing */
}
END
