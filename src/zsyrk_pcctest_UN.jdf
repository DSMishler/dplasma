 *
 */
#include "dplasmajdf.h"
#include "parsec/data_dist/matrix/matrix.h"
#include <math.h>
#include <sys/time.h>

%}

uplo      [type = "dplasma_enum_t"]
trans     [type = "dplasma_enum_t"]
alpha     [type = "dplasma_complex64_t"]
descA     [type = "const parsec_tiled_matrix_t*"]
beta      [type = "dplasma_complex64_t"]
descC     [type = "parsec_tiled_matrix_t*"]

/*******************************************************************
 *              zsyrk_pcctest                                      *
 *******************************************************************/
zsyrk_pcctest(n, k) [ flops = inline_c %{ return FLOPS_ZSYRK(CLEAN_NB(descC, n), CLEAN_NB(descA, k)); %} ]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descC(n,n)

  READ  A    <- A zsyrk_pcctest_in_data_A0(n, k)
  RW    C    <- ((0==k)) ? descC(n,n)
             <- ((k>=1)) ? C zsyrk_pcctest(n, k-1)
             -> ((descA->nt>=(2+k))) ? C zsyrk_pcctest(n, k+1)
             -> ((descA->nt==(k+1))) ? C zsyrk_write_C(n,n)

BODY
{
    if (k == 0)
    {
        FILE *ft;
        ft = fopen("timing_data/compute_begin.txt", "r+");
        int ftd = fileno(ft);
        struct timeval t;
        gettimeofday(&t, NULL);
        int which_entry=((n*(n+1))/2)+n;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,m=%04d:%010ld.%06ld\n", n, n, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
    int tempnn = (n==(descC->nt-1)) ? (descC->n-(n*descC->nb)) : descC->nb;
    int tempkn = (k==(descA->nt-1)) ? (descA->n-(k*descA->nb)) : descA->nb;
    int ldan = BLKLDD( descA, n );
    dplasma_complex64_t zbeta = (k==0) ? beta : ((dplasma_complex64_t)1.);
    int ldcn = BLKLDD( descC, n );

    printlog("CORE_zsyrk(%d, %d)\n"
             "\t(uplo, trans, tempnn=%d, tempkn=%d, alpha, A(%d,%d)[%p], ldan=%d, zbeta, C(%d,%d)[%p], ldcn=%d)\n",
             n, k, tempnn, tempkn, n, k, A, ldan, n, n, C, ldcn );
    CORE_zsyrk(uplo, trans, tempnn, tempkn,
               alpha, A /* descA(n,k) */, ldan,
               zbeta, C /* descC(n,n) */, ldcn );
    // printf("This is PCCTEST zsyrk zsyrk! (%d, %d, %d)\n", n, n, k);
    // ((dplasma_complex64_t *)C)[0] = 2.0; // signal of victory
    if (k == descA->nt-1)
    {
        struct timeval t;
        gettimeofday(&t, NULL);
        FILE *ft;
        ft = fopen("timing_data/compute_end.txt", "r+");
        int ftd = fileno(ft);
        int which_entry=((n*(n+1))/2)+n;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,m=%04d:%010ld.%06ld\n", n, n, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
}
END

/*******************************************************************
 *              PCC_load_A                                         *
 *******************************************************************/
// load in the matrix A, and add dependencies for the other tasks
PCC_load_A(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descA->mt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

RW A <- descA(n,k)
     -> A PCC_preprocess_Ap0(n,k)

// old dependencies from trying to get it to read a full line and sort out
// over here - for now we're going to just read in the correct file based
// on n and k
// CTL pass <- (n > 0) ? pass PCC_load_A(n-1)
         // -> (n < descC->nt-1) ? pass PCC_load_A(n+1)

BODY
{
    if (1) // always do this
    {
        FILE *ft;
        ft = fopen("timing_data/input_begin.txt", "r+");
        int ftd = fileno(ft);
        struct timeval t;
        gettimeofday(&t, NULL);
        int which_entry=(n*descA->nt-1)+k;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,k=%04d:%010ld.%06ld\n", n, k, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);

    }
    char fname[100];
    sprintf(fname, "split_input_data/split_sample_%d_%d.csv", n, k);
    
    int ldam = BLKLDD( descA, m ); // TODO: ldam or ldan? Likewise in preprocess
    // int ldan = BLKLDD( descA, n ); // TODO: ldam or ldan? Likewise in preprocess
    int tempnn = (n == descA->nt-1) ? descA->n - n*descA->nb : descA->nb;
    int tempkn = (k == descA->nt-1) ? descA->n - k*descA->nb : descA->nb;
    // printf("PCC load n=%d, k=%d, ldam=%d ldan=%d\n", n, k, ldam, ldan);
    // printf("do we have descA->mt & nt? %d %d\n", descA->mt, descA->nt);
    // printf("PCC load tempnn=%d, tempkn=%d\n", tempnn, tempkn);
    // printf("do we have descA->lm & ln? %d %d\n", descA->lm, descA->ln);
    FILE *f;
    f = fopen(fname, "r");
    if (f == NULL)
    {
        printf("ERROR: failed to load '%s'\n", fname);
    }
    int i, j;
    int fsfrv;
    for(i = 0; i < tempnn; i++)
    {
        for(j = 0; j < tempkn; j++)
        {
            fsfrv = fscanf(f, "%lf,", (&(((dplasma_complex64_t*)A)[i+ldam*j])));
        }
    }

    if (fsfrv == 0)
    {
        ; // keep compilers happy
    }
    fclose(f);
    // printf("Load A! This should load A(%d,%d)\n", n, k);
    if (1) // always do this
    {
        struct timeval t;
        gettimeofday(&t, NULL);
        FILE *ft;
        ft = fopen("timing_data/input_end.txt", "r+");
        int ftd = fileno(ft);
        int which_entry=(n*descA->nt-1)+k;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,k=%04d:%010ld.%06ld\n", n, k, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
}
END

/*******************************************************************
 *              PCC_preprocess_Ap0                                  *
 *******************************************************************/
PCC_preprocess_Ap0(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

  READ  A    <- A PCC_load_A(n,k)
             -> A PCC_preprocess_Ap1(n,k)
  RW    C    <- (k == 0) ? C PCC_grab_C(n,n)
             <- (k >  0) ? C PCC_preprocess_Ap0(n,k-1)
             -> (k != descA->nt-1) ? C PCC_preprocess_Ap0(n,k+1)
             -> (k == descA->nt-1) ? C PCC_calc_std(n,n)
  CTL   pass -> (k == descA->nt-1) ? pass PCC_preprocess_Ap1(n,0..descA->nt-1) // TODO: might be not needed because of the calc std step.

BODY
{
    // printf("preprocess part 0 n=%d k=%d\n", n, k);
    /* set the first column of C to be the sum of all values in that row of A */
    /* set the second column of C to be the sum of all squared values */
    /* Add to C as we get started */
    int ldan = BLKLDD( descA, n );
    int tempnn = (n == descA->nt-1) ? descA->n - n*descA->nb : descA->nb;
    int tempkn = (k == descA->nt-1) ? descA->n - k*descA->nb : descA->nb;

    int i, j;
    if (1) //always do this, don't just do when k==0
    {
        FILE *ft;
        ft = fopen("timing_data/preprocess_begin.txt", "r+");
        int ftd = fileno(ft);
        struct timeval t;
        gettimeofday(&t, NULL);
        int which_entry=(n*descA->nt-1)+k;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,k=%04d:%010ld.%06ld\n", n, k, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }

    if (k == 0)
    {
        for (i = 0; i < tempnn * 2; i++) // clear out C matrix
        {
            ((dplasma_complex64_t *)C)[i] = 0;
        }
    }

    for (i = 0; i < tempnn; i++)
    {
        for (j = 0; j < tempkn; j++)
        {
            ((dplasma_complex64_t*)C)[i] += ((dplasma_complex64_t *)A)[i+j*ldan];
            ((dplasma_complex64_t*)C)[i+1*ldan] +=
                (((dplasma_complex64_t *)A)[i+j*ldan]) *
                (((dplasma_complex64_t *)A)[i+j*ldan]);
            /* printf("(C[%d],C[%d])=(%lf,%lf)\n", i, i+ldan,
                ((dplasma_complex64_t *)C)[i], ((dplasma_complex64_t *)C)[i+ldan]); */
        }
    }
}
END

/*******************************************************************
 *              PCC_preprocess_Ap1                                  *
 *******************************************************************/
PCC_preprocess_Ap1(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

  READ  A    <- A PCC_preprocess_Ap0(n,k)
             -> A zsyrk_pcctest_in_data_A0(n,k)
             -> A zgemm_in_data_A0(n,k) // TODO: this appears to over-give the data by giving to tasks that don't exist
             -> B zgemm_in_data_A1(n,k)
  READ  C    <- C PCC_calc_std(n,n)
  CTL   pass <- pass PCC_preprocess_Ap0(n, descA->nt-1)

BODY
{
    /* set every element in row R to be r<-(r-mean(R))/std(R)/sqrt(len(R)) */
    // printf("preprocess part 1 n=%d k=%d\n", n, k);
    int ldan = BLKLDD( descA, n );
    int tempnn = (n == descA->nt-1) ? descA->n - n*descA->nb : descA->nb;
    int tempkn = (k == descA->nt-1) ? descA->n - k*descA->nb : descA->nb;

    int i, j;

    for (i = 0; i < tempnn; i++) // TODO: switch loop order (j over i)
    {
        for (j = 0; j < tempkn; j++)
        {
            /* r = (r-mean(R)) / std(R) / sqrt(len(R)) */
            ((dplasma_complex64_t*)A)[i+j*ldan] =
               ( ((dplasma_complex64_t *)A)[i+j*ldan] - ((dplasma_complex64_t *)C)[i] ) /
               ( ((dplasma_complex64_t *)C)[i+1*ldan] ) / sqrt( descA->ln );
            /* printf("(C[%d],C[%d])=(%lf,%lf)\n", i, i+ldan,
                ((dplasma_complex64_t *)C)[i], ((dplasma_complex64_t *)C)[i+ldan]); */
        }
    }
    if (1) // always do this
    {
        struct timeval t;
        gettimeofday(&t, NULL);
        FILE *ft;
        ft = fopen("timing_data/preprocess_end.txt", "r+");
        int ftd = fileno(ft);
        int which_entry=(n*descA->nt-1)+k;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,k=%04d:%010ld.%06ld\n", n, k, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
}
END


/*******************************************************************
 *              zsyrk_pcctest_in_data_A0                           *
 *******************************************************************/
zsyrk_pcctest_in_data_A0(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

  READ  A    <- A PCC_preprocess_Ap1(n,k)
             -> A zsyrk_pcctest(n, k)

BODY
{
    /* nothing */
}
END

/*******************************************************************
 *              zgemm                                              *
 *******************************************************************/
zgemm(n, m, k) [ flops = inline_c %{ return FLOPS_ZGEMM(CLEAN_NB(descC, n), CLEAN_MB(descC, m), CLEAN_NB(descA, k)); %} ]
  /* Execution Space */
  n = 0..(descC->mt-2)
  m = (n+1)..(descC->mt-1)
  k = 0..(descA->nt-1)

  /* Locality */
  : descC(n,m)

  READ  A    <- A zgemm_in_data_A0(n, k)
  READ  B    <- B zgemm_in_data_A1(m, k)
  RW    C    <- ((0==k)) ? descC(n,m)
             <- ((k>=1)) ? C zgemm(n, m, k-1)
             -> ((descA->nt>=(k+2))) ? C zgemm(n, m, k+1)
             -> ((descA->nt==(k+1))) ? C zsyrk_write_C(n,m)

BODY
{
    if (k == 0)
    {
        FILE *ft;
        ft = fopen("timing_data/compute_begin.txt", "r+");
        int ftd = fileno(ft);
        struct timeval t;
        gettimeofday(&t, NULL);
        int which_entry=((m*(m+1))/2)+n;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,m=%04d:%010ld.%06ld\n", n, m, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
    int tempnn = (n==(descC->nt-1)) ? (descC->n-(n*descC->nb)) : descC->nb;
    int tempmm = ((m)==(descC->mt-1)) ? (descC->m-(m*descC->mb)) : descC->mb;
    int tempkn = (k==(descA->nt-1)) ? (descA->n-(k*descA->nb)) : descA->nb;
    int ldan = BLKLDD( descA, n );
    int ldam = BLKLDD( descA, m );
    dplasma_complex64_t zbeta = (k==0) ? beta : (dplasma_complex64_t)1.;
    int ldcn = BLKLDD( descC, n );

    // printf("This is PCCTEST zsyrk gemm! (%d, %d, %d)\n", n, m, k);
    printlog("CORE_zgemm(%d, %d, %d)\n"
             "\t(trans, dplasmaTrans, tempnn, tempmm, tempkn, zalpha, A(%d,%d)[%p], ldan, A(%d,%d)[%p], ldam, zbeta, C(%d,%d)[%p], ldcn)\n",
             n, m, k, n, k, A, m, k, B, n, m, C);
    CORE_zgemm(trans, dplasmaTrans, tempnn,
               tempmm, tempkn, alpha,
               A /* descA(n,k) */, ldan, B /* descA(m,k) */,
               ldam, zbeta, C /* descC(n,m) */,
               ldcn );
    if (k == descA->nt-1)
    {
        struct timeval t;
        gettimeofday(&t, NULL);
        FILE *ft;
        ft = fopen("timing_data/compute_end.txt", "r+");
        int ftd = fileno(ft);
        int which_entry=((m*(m+1))/2)+n;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,m=%04d:%010ld.%06ld\n", n, m, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
}
END

/*******************************************************************
 *              zgemm_in_data_A1                                   *
 *******************************************************************/
zgemm_in_data_A1(m, k) [profile = off]
  /* Execution Space */
  m = 1..(descC->mt-1) /* tight bound is (n+1)..(descC->mt-1) */
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(m,k)

  READ  B    <- A PCC_preprocess_Ap1(m,k)
             -> B zgemm(0..(descC->mt-2), m, k)

BODY
{
    /* nothing */
}
END

/*******************************************************************
 *              zgemm_in_data_A0                                   *
 *******************************************************************/
zgemm_in_data_A0(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->mt-2)
  k = 0..(descA->nt-1)

  /* Locality */
  : descA(n,k)

  READ  A    <- A PCC_preprocess_Ap1(n,k)
             -> A zgemm(n, (n+1)..(descC->mt-1), k)

BODY
{
    /* nothing */
}
END

/*******************************************************************
 *              zsyrk_write_C                                      *
 *******************************************************************/
zsyrk_write_C(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->mt-1) // mt is the parameter for nrows, but we use n here
  k = (n)..(descC->nt-1)

  /* Locality */
  : descC(n,k)

  RW  C    <- (n == k) ? C zsyrk_pcctest(n, descA->nt-1)
           <- (n < k)  ? C zgemm(n, k, descA->nt-1)
           -> descC(n,k) // I think this write isn't needed. TODO you can remove this.

BODY
{
    if (1) // always do this
    {
        FILE *ft;
        ft = fopen("timing_data/output_begin.txt", "r+");
        int ftd = fileno(ft);
        struct timeval t;
        gettimeofday(&t, NULL);
        int which_entry=((k*(k+1))/2)+n;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,k=%04d:%010ld.%06ld\n", n, k, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }
    int tempnn = (n==(descC->nt-1)) ? (descC->n-(n*descC->nb)) : descC->nb;
    int tempmm = ((k)==(descC->mt-1)) ? (descC->m-(k*descC->mb)) : descC->mb;
    int ldcn = BLKLDD( descC, n );
    // printf("n=%d,tempnn=%d\n", n, tempnn);
    // printf("k=%d,tempmm=%d\n", k, tempmm);

    // // printf("zsyrk write C with n=%d k=%d\n", n, k);
    // char fname[100];
    // sprintf(fname, "split_output_data/output_%d_%d.csv", n, k);
    // // printf("writing to `%s`\n", fname);
    // f = fopen(fname, "w");
    // for(i = 0; i < tempnn; i++)
    // {
        // for(j = 0; j < tempmm - 1; j++)
        // {
            // fprintf(f, "%.3lf,", ((dplasma_complex64_t*)C)[i+j*ldcn]);
        // }
        // fprintf(f, "%.3lf\n", ((dplasma_complex64_t*)C)[i+j*ldcn]);
    // }

    // fclose(f);

    FILE *f;
    int i, j;
    f = fopen("output_data/PCC_output.csv", "r+");
    int fd = fileno(f);

    // one "line" is 7 times the tilesize
    // +0.000,-0.876,+0.987,-0.111,...
    // 1234567123456712345671234567
    char *s_tofile;
    long int file_offset;
    s_tofile = malloc(7*tempnn+1); // one more for string terminator


    // now, we'll be getting the UPPER triangle with the tiles we have,
    // but I'll be writing it TRANSPOSED to the LOWER triangle because
    // that's easier with a file
    // [[i=0,j=0], [i=0,j=1],
    //  [i=1,j=0], [i=1,j=1]]
    // And note: dplasma is column-major, so just iterating through i gets you
    // the column, but we'll write it as a row

    for(j = 0; j < tempmm; j++)
    {
        // printf("n=%d, k=%d, j=%d\n", n, k, j);
        s_tofile[0] = '\0';

        if(n != k)
        {
            // TODO: careful, we aren't guaranteed that all tiles are square
            // then write everything
            for(i = 0; i < tempnn-1; i++)
            {
                sprintf(s_tofile+7*i, "%+.3lf,", ((dplasma_complex64_t*)C)[i+j*ldcn]);
            }
        }
        else
        {
            // n == k, so we only write up to the diagonal, where i == j
            for(i = 0; i < j; i++)
            {
                sprintf(s_tofile+7*i, "%+.3lf,", ((dplasma_complex64_t*)C)[i+j*ldcn]);
            }
        }
        // last one (we intentionally used bounds minus 1 up above)
        sprintf(s_tofile+7*i, "%+.3lf", ((dplasma_complex64_t*)C)[i+j*ldcn]);
        if (n == k)
        {
            sprintf(s_tofile+7*i+6, "\n");
        }
        else
        {
            sprintf(s_tofile+7*i+6, ",");
        }
        i++;

        long int which_col = (descC->nb*k+j); // this is which col in C
        // descC->nb*k gives me which col I started on, then add j to
        // get current col (would be column in the tile, but remember
        // we transposed) and want this to be a row in the file

        file_offset = 7*( (((which_col)*(which_col+1))/2) + descC->mb*n);
        // using the triangle (n)(n+1)/2 to get offset up to my row,
        // then just adding descC->nb*k to get which column I'd be on

        // printf("writing of length %d to offset entry %ld\n", i, file_offset/7);

        pwrite(fd, s_tofile, 7*i, file_offset);
    }

    free(s_tofile);

    fclose(f);



    if (1) // always do this
    {
        struct timeval t;
        gettimeofday(&t, NULL);
        FILE *ft;
        ft = fopen("timing_data/output_end.txt", "r+");
        int ftd = fileno(ft);
        int which_entry=((k*(k+1))/2)+n;
        char timing_infobuf[64];
        int entrylen=2+4+3+4+1+10+1+6+1;
        sprintf(timing_infobuf, "n=%04d,k=%04d:%010ld.%06ld\n", n, k, t.tv_sec, t.tv_usec);
        pwrite(ftd, timing_infobuf, entrylen, which_entry*entrylen);
        fclose(ft);
    }

}
END


/*******************************************************************
 *              PCC_grab_C                                         *
 *******************************************************************/
PCC_grab_C(n, k) [profile = off]
  /* Execution Space */
  n = 0..(descC->nt-1)
  k = n

  /* Locality */
  : descC(n,n)

  READ  C    <- descC(n,n)
             -> C PCC_preprocess_Ap0(n,0)

BODY
{
    /* empty */
    // printf("grab C n=%d k=%d\n", n, k);
    // printf("grab C note: n could get to=%d\n", descC->nt-1);
}
END

/*******************************************************************
 *              PCC_calc_std                                       *
 *******************************************************************/
PCC_calc_std(n, k) [profile = off]
  /* Execution Space */ n = 0..(descC->nt-1)
  k = n

  /* Locality */
  : descC(n,n)

  RW    C    <- C PCC_preprocess_Ap0(n, descA->nt-1)
             -> C PCC_preprocess_Ap1(n, 0..descA->nt-1)

BODY
{
    /* take the sum of squares, use the sum, and calculate standard deviation*/
    // printf("calc std n=%d k=%d\n", n, k);
    int ldan = BLKLDD( descA, n );
    int tempnn = (n == descA->nt-1) ? descA->n - n*descA->nb : descA->nb;
    // int tempkn = (k == descA->nt-1) ? descA->n - k*descA->nb : descA->nb;

    int i;
    // print loop
    // for(i = 0; i < tempnn*0 /* x0 for commenting it out */; i++)
    // {
        // printf("(C[%d],C[%d])=(%lf,%lf)\n", i, i+ldan,
         // ((dplasma_complex64_t *)C)[i], ((dplasma_complex64_t *)C)[i+ldan]);
    // }
    // calculate std
    for(i = 0; i < tempnn; i++)
    {
        // get the expectation values
        ((dplasma_complex64_t *)C)[i] = ((dplasma_complex64_t *)C)[i]/descA->ln;
        ((dplasma_complex64_t *)C)[i+ldan] = ((dplasma_complex64_t *)C)[i+ldan]/descA->ln;
        // std = sqrt(E(a^2) - E(a)^2)
        ((dplasma_complex64_t *)C)[i+ldan] =
            sqrt(((dplasma_complex64_t *)C)[i+ldan] -
            ((dplasma_complex64_t *)C)[i] * ((dplasma_complex64_t *)C)[i]);
    }
    // print loop
    // for(i = 0; i < tempnn*0; i++)
    // {
        // printf("(C[%d],C[%d])=(%lf,%lf)\n", i, i+ldan,
         // ((dplasma_complex64_t *)C)[i], ((dplasma_complex64_t *)C)[i+ldan]);
    // }
}
END
